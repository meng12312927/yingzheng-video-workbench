# 复制为 .env 后填写自己的密钥；不要提交 .env。

# OpenAI-compatible 聊天模型。也可以替换为 DeepSeek 等兼容服务。
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# 可选：向量证据检索服务。留空时系统自动使用本地 BM25。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# macOS 默认使用 CPU + int8；追求更高准确率时可评估 large-v3。
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Apple VideoToolbox；本机 FFmpeg 不支持时改为 libx264。
VIDEO_ENCODER=h264_videotoolbox

# 留空时自动选择可用端口；需要固定端口时填写数字，例如 7960。
GRADIO_SERVER_PORT=
GRADIO_SERVER_NAME=127.0.0.1
MOBILE_REVIEW_PORT=7961
# 局域网手机审核时改为电脑的局域网 IP，例如 http://192.168.1.20:7961
MOBILE_REVIEW_BASE_URL=http://127.0.0.1:7961

# 可选服务；留空时继续使用当前本地文件、进程锁和本地幂等实现。
DATABASE_URL=
REDIS_URL=
