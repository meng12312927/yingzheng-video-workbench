# 复制为 .env 后填入自己的密钥；不要提交 .env。
# OpenAI 兼容 LLM。DeepSeek 示例：
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60

# 可选：向量证据检索服务。未配置时自动退化为本地 BM25。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# macOS 默认使用 CPU + int8。可将模型换为 large-v3 以提高准确率。
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Apple VideoToolbox；若本机 FFmpeg 不支持可改为 libx264。
VIDEO_ENCODER=h264_videotoolbox
# 留空=自动选择可用端口；需要固定端口时填写数字，例如 7861。
GRADIO_SERVER_PORT=
####
